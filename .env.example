FILE2DOC_STORAGE_ROOT=/data/file2doc
FILE2DOC_AUTH_ENABLED=true
FILE2DOC_BEARER_TOKEN=replace-with-a-long-random-token
FILE2DOC_LOCAL_ASR_MODEL_DIR=/data/file2doc/models/sherpa-paraformer-zh

# File2Doc Visual Parsing provider for standalone image conversion.
FILE2DOC_VISUAL_MODEL=
FILE2DOC_VISUAL_API_KEY=
FILE2DOC_VISUAL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
FILE2DOC_VISUAL_TIMEOUT_SECONDS=300

# Existing PDF OCR recovery configuration; removed by the runtime cutover slice.
FILE2DOC_OCR_MODEL=
FILE2DOC_OCR_API_KEY=
FILE2DOC_OCR_BASE_URL=
