FILE2DOC_STORAGE_ROOT=/data/file2doc
FILE2DOC_AUTH_ENABLED=true
FILE2DOC_BEARER_TOKEN=replace-with-a-long-random-token
FILE2DOC_LOCAL_ASR_ENGINE=funasr-local
FILE2DOC_LOCAL_ASR_MODEL_DIR=/data/file2doc/models/funasr

# Optional outside PROD; PROD requires a dedicated Ark visual provider.
FILE2DOC_VISUAL_MODEL=
FILE2DOC_VISUAL_API_KEY=
FILE2DOC_VISUAL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
FILE2DOC_VISUAL_ITEM_TIMEOUT_SECONDS=300
FILE2DOC_VISUAL_JOB_DEADLINE_SECONDS=900
FILE2DOC_VISUAL_MAX_CONCURRENCY=4
